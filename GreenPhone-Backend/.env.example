# ============================
# GreenPhone Environment Config
# Copy this to .env and fill in your values
# ============================

# Database
DB_URL=jdbc:mysql://localhost:3306/greenphone
DB_USERNAME=root
DB_PASSWORD=

# Server
SERVER_PORT=8080

# JWT (change this in production!)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION=86400000

# JPA / Hibernate
DDL_AUTO=update
SHOW_SQL=false

# Logging
LOG_LEVEL=DEBUG

# ============================
# Cloudinary (Image Storage)
# Get credentials at https://console.cloudinary.com
# ============================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================
# Sepay (VietQR Payment)
# Register at https://sepay.vn
# ============================
SEPAY_ACCOUNT_NUMBER=your_bank_account
SEPAY_BANK_CODE=VCB
SEPAY_ACCOUNT_HOLDER=NGUYEN_VAN_A
SEPAY_STORE_NAME=GreenPhone

# One of them, both is optinal if failed router other
SEPAY_API_TOKEN=your_sepay_api_token
SEPAY_WEBHOOK_SECRET=your_webhook_secret

# ============================
# MapBox (Address autocomplete)
# Get your token at https://account.mapbox.com/access-tokens
# ============================
VITE_MAPBOX_TOKEN=your_mapbox_public_token

# ============================
# Mail (Java Mail Sender)
# For Gmail: enable App Password at https://myaccount.google.com/apppasswords
# ============================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
