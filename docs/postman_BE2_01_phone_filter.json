  "item": [
    {
      "name": "01. Bộ lọc cơ bản (Single Filters)",
      "item": [
        {
          "name": "1.1 Lấy danh mục Hãng phục vụ Dropdown lọc (/api/phones/filters)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Trả về danh sách thương hiệu không bị N+1\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.have.property('brands');",
                  "    pm.expect(json.data.brands).to.be.an('array');",
                  "    pm.expect(json.data.brands.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/phones/filters",
              "host": ["{{base_url}}"],
              "path": ["api", "phones", "filters"]
            }
          }
        },
        {
          "name": "1.2 Lọc theo 1 Hãng sản xuất (Apple: brandIds=1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Chỉ trả về các sản phẩm của Apple (brandId=1)\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.content).to.be.an('array');",
                  "    json.data.content.forEach(function(phone) {",
                  "        pm.expect(phone.brandId).to.eql(1);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/phones?brandIds=1",
              "host": ["{{base_url}}"],
              "path": ["api", "phones"],
              "query": [
                {
                  "key": "brandIds",
                  "value": "1"
